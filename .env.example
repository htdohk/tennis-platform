# ====== 数据库 ======
DATABASE_URL=postgresql://dev:dev@localhost:5432/tennis
REDIS_URL=redis://localhost:6379

# ====== 鉴权 ======
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
SESSION_SECRET=change-this-to-another-long-random-string-min-32-chars

# ====== 业务逻辑 LLM(意图识别、订单解析等)======
# OpenAI 兼容规范,支持 DeepSeek/通义/OpenAI 等
BUSINESS_LLM_BASE_URL=https://api.deepseek.com/v1
BUSINESS_LLM_API_KEY=sk-xxx
BUSINESS_LLM_MODEL=deepseek-chat
# (可选)如需更高级别 LLM 处理复杂任务,启用以下配置
# ADVANCED_LLM_BASE_URL=https://api.openai.com/v1
# ADVANCED_LLM_API_KEY=sk-xxx
# ADVANCED_LLM_MODEL=gpt-4o

# ====== 品牌定制 ======
BRAND_NAME=测试网球馆
BRAND_LOGO_URL=https://example.com/logo.png
PUBLIC_WEB_BASE_URL=http://localhost:3001
PUBLIC_ADMIN_BASE_URL=http://localhost:3002
# Next.js 前端用(public 变量)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=测试网球馆

# ====== MCP Server ======
MCP_SERVER_PORT=3100
MCP_INTERNAL_TOKEN=change-this-internal-token

# ====== 端口配置(本地开发)======
API_PORT=3000
WEB_CUSTOMER_PORT=3001
WEB_ADMIN_PORT=3002

# ====== 业务默认值 ======
DEFAULT_RECRUIT_LEVEL_TOLERANCE=0.5
SLOT_GRANULARITY_MINUTES=30

# ====== 日志 ======
LOG_LEVEL=info
NODE_ENV=development