# ====== 数据库连接 ======
# PostgreSQL 连接字符串（Docker 部署时 host 为 postgres，本地开发为 localhost）
DATABASE_URL=postgresql://dev:dev@postgres:5432/tennis
# Redis 连接字符串（Docker 部署时 host 为 redis，本地开发为 localhost）
REDIS_URL=redis://redis:6379

# ====== PostgreSQL 凭证 ======
POSTGRES_DB=tennis
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev

# ====== 鉴权 ======
# JWT 密钥，请替换为随机长字符串（建议 32 位以上）
JWT_SECRET=change-this-to-a-long-random-string
# JWT 过期时间，格式如 7d(7 天)、24h(24 小时)
JWT_EXPIRES_IN=7d
# Session 密钥，请替换为随机长字符串（建议 32 位以上）
SESSION_SECRET=change-this-to-another-long-random-string-min-32-chars

# ====== 业务逻辑 LLM(意图识别、订单解析等)======
# OpenAI 兼容规范，支持 DeepSeek/通义/OpenAI 等
BUSINESS_LLM_BASE_URL=https://api.deepseek.com/v1
BUSINESS_LLM_API_KEY=sk-xxx
BUSINESS_LLM_MODEL=deepseek-chat
# (可选)如需更高级别 LLM 处理复杂任务，启用以下配置
# ADVANCED_LLM_BASE_URL=https://api.openai.com/v1
# ADVANCED_LLM_API_KEY=sk-xxx
# ADVANCED_LLM_MODEL=gpt-4o

# ====== 品牌定制 ======
# 场馆品牌名称，显示在网页标题和 C 端首页
BRAND_NAME=测试网球馆
BRAND_LOGO_URL=https://example.com/logo.png
# C 端网页外网访问地址（用于 MCP 生成的订单详情链接）
PUBLIC_WEB_BASE_URL=http://your-domain.com
PUBLIC_ADMIN_BASE_URL=http://your-domain.com/admin

# ====== Next.js 前端 Build-time 变量 ======
# 注意：NEXT_PUBLIC_* 变量在 Docker build 时注入，非运行时
# 生产环境（通过 nginx 反向代理）：http://your-domain/api
# 开发环境（直连）：http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_BRAND_NAME=测试网球馆

# ====== MCP Server ======
# MCP Server 内部通信地址（Docker 部署时指向 api 容器）
MCP_SERVER_PORT=3100
MCP_INTERNAL_TOKEN=change-this-internal-token
INTERNAL_API_BASE_URL=http://api:3000

# ====== 业务默认值 ======
# 招募局默认段位浮动范围（用户可自行调整）
DEFAULT_RECRUIT_LEVEL_TOLERANCE=0.5
# 时段颗粒度（分钟），固定 30 分钟
SLOT_GRANULARITY_MINUTES=30

# ====== 日志 ======
# 日志级别：debug / info / warn / error
LOG_LEVEL=info
# 运行环境：development / production
NODE_ENV=production
